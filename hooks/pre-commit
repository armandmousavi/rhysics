#!/bin/bash

# Pre-commit hook: Build and export simulations when source files change

set -e

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

TARGET_REPO="${HOME}/Documents/armandmousavi.github.io"
TARGET_DIR="${TARGET_REPO}/rhysics"
GITHUB_REPO="git@github.com:armandmousavi/armandmousavi.github.io.git"

# Check if any simulation source files are staged
STAGED_FILES=$(git diff --cached --name-only)

# Check for changes in simulation source files or common library
if echo "$STAGED_FILES" | grep -qE '(chapter_[0-9]+/section_[0-9]+/.+/src/|common/src/|chapter_[0-9]+/section_[0-9]+/.+/Cargo\.toml|common/Cargo\.toml)'; then
    echo -e "${BLUE}Simulation source files changed - building exports...${NC}"
    echo ""
    
    # Clone target repo if it doesn't exist
    if [ ! -d "$TARGET_REPO/.git" ]; then
        echo -e "${BLUE}Cloning target repo...${NC}"
        git clone "$GITHUB_REPO" "$TARGET_REPO"
    else
        # Pull latest changes
        echo -e "${BLUE}Pulling latest from target repo...${NC}"
        cd "$TARGET_REPO"
        git pull --ff-only || true
        cd - > /dev/null
    fi
    
    # Run export
    ./export.sh --all "$TARGET_DIR"
    
    # Commit and push the built files
    cd "$TARGET_REPO"
    git add rhysics/
    
    if git diff --staged --quiet; then
        echo -e "${YELLOW}No changes to deploy${NC}"
    else
        git commit -m "Update rhysics simulations"
        git push
        echo -e "${GREEN}✓ Simulations deployed to GitHub Pages${NC}"
    fi
    
    echo ""
fi
